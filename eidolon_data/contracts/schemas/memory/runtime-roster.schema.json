{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eidolon.dev/data/contracts/v1/memory/runtime-roster.schema.json",
  "title": "Memory runtime roster",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "operation", "realms"],
  "properties": {
    "contract_version": {"const": "1"},
    "operation": {"const": "memory.runtime-roster"},
    "realms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["realm_id", "owner_id", "engine", "engine_config"],
        "properties": {
          "realm_id": {"type": "string", "minLength": 1, "maxLength": 64},
          "owner_id": {"type": "string", "minLength": 1, "maxLength": 64},
          "engine": {"type": "string", "minLength": 1, "maxLength": 64},
          "engine_config": {"type": "object"}
        }
      }
    }
  }
}
